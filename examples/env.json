{
    "scope": "examples",
    "working-directory": ".",
    "queues": [
        // everything the examples publish (heartbeats)
        { "name": "heartbeat@data", "type": "multicast", "capacity": "64MiB" },
        // requests to the service (opened by the heartbeat example, not served)
        { "name": "heartbeat@cmd", "type": "mpsc", "length": 1024, "slot-size": "128B" }
    ]
}
