<?xml version="1.0" encoding="UTF-8"?>
<!-- Metadata service: reference data about instruments and about market data services.

     Like every service in the system, Metadata has two queues:
       - multicast queue: publishes spontaneous updates (clientId = null,
         requestId = 0) and responses to requests;
       - MPSC queue: receives requests.
     Clients match responses by (clientId, requestId) and updates by content. -->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   xmlns:xi="http://www.w3.org/2001/XInclude"
                   package="meta" id="2" version="0" semanticVersion="0.1"
                   byteOrder="littleEndian" description="Metadata">

  <!-- messageHeader, groupSizeEncoding, varStringEncoding, InstrumentId, ServiceId,
       ClientId, Timestamp, Price, Qty, *NULL types, RequestStatus -->
  <xi:include href="common_types.xml"/>

  <types>
    <!-- ===== Enums ===== -->
    <enum name="InstrumentType" encodingType="uint8">
      <validValue name="Spot">0</validValue>
      <validValue name="Future">1</validValue>
      <validValue name="Option">2</validValue>
      <validValue name="Spread">3</validValue>
      <validValue name="Swap">4</validValue>
    </enum>

    <enum name="InstrumentState" encodingType="uint8">
      <validValue name="Active">0</validValue>
      <validValue name="Suspended">1</validValue> <!-- reference-level state, not a trading phase -->
      <validValue name="Expired">2</validValue>
      <validValue name="Delisted">3</validValue>
    </enum>

    <enum name="ServiceState" encodingType="uint8">
      <validValue name="Active">0</validValue>
      <validValue name="Inactive">1</validValue> <!-- e.g. graceful shutdown -->
    </enum>

    <enum name="RegisterStatus" encodingType="uint8">
      <validValue name="Created">0</validValue>        <!-- new entry, id assigned -->
      <validValue name="Updated">1</validValue>        <!-- attributes changed, version incremented -->
      <validValue name="Unchanged">2</validValue>      <!-- known entry, same attributes -->
      <validValue name="Rejected">3</validValue>       <!-- e.g. attempt to change an immutable attribute -->
      <validValue name="UnknownService">4</validValue> <!-- instrument registered for an unregistered service -->
    </enum>

    <!-- Which market data streams the service provides for the instrument -->
    <set name="Capabilities" encodingType="uint16">
      <choice name="Mbp">0</choice>
      <choice name="Mbo">1</choice>
      <choice name="Trades">2</choice>
      <choice name="Statistics">3</choice>
      <choice name="Status">4</choice>
    </set>

    <!-- Everything about an instrument except its identity, version and
         report time. Shared by RegisterInstrument and InstrumentDefinition.
         serviceId, venueId and exchangeSymbol form the natural key of an
         instrument; instrumentType is immutable for a registered key.
         The same exchange instrument received through different services is
         registered as different instruments (different instrumentId). -->
    <composite name="InstrumentAttributes">
      <type name="venueId"        primitiveType="uint16"/>
      <ref  name="serviceId"      type="ServiceId"/>      <!-- market data service the instrument was created from -->
      <ref  name="instrumentType" type="InstrumentType"/>
      <ref  name="state"          type="InstrumentState"/>
      <ref  name="tickSize"       type="PriceNULL"/>      <!-- null: no single tick size -->
      <ref  name="lotSize"        type="QtyNULL"/>
      <ref  name="multiplier"     type="QtyNULL"/>        <!-- null: not applicable -->
      <ref  name="expiry"         type="TimestampNULL"/>  <!-- null: perpetual -->
      <ref  name="currency"       type="UInt32NULL"/>
      <ref  name="capabilities"   type="Capabilities"/>
    </composite>
  </types>

  <!-- ================= Market data service -> Metadata ================= -->

  <!-- Idempotent upsert by the natural key: service name.
       A service registers itself on startup, before registering instruments.
       Changing queue names or state increments version.
       reportedTs: time when the service reported itself; it does not affect version. -->
  <sbe:message name="RegisterService" id="10">
    <field name="clientId"   id="1" type="ClientId"/>
    <field name="requestId"  id="2" type="uint64"/>
    <field name="reportedTs" id="3" type="Timestamp"/>
    <field name="state"      id="4" type="ServiceState"/>
    <data  name="name"         id="5" type="varStringEncoding"/> <!-- unique service name -->
    <data  name="dataQueue"    id="6" type="varStringEncoding"/> <!-- shm name of the multicast queue: data and responses -->
    <data  name="requestQueue" id="7" type="varStringEncoding"/> <!-- shm name of the MPSC queue: requests -->
  </sbe:message>

  <sbe:message name="RegisterServiceResult" id="11">
    <field name="clientId"  id="1" type="ClientId"/>
    <field name="requestId" id="2" type="uint64"/>
    <field name="status"    id="3" type="RegisterStatus"/>
    <field name="serviceId" id="4" type="ServiceIdNULL" presence="optional"/> <!-- null if Rejected -->
    <field name="version"   id="5" type="uint32"/>
  </sbe:message>

  <!-- Idempotent upsert by the natural key (serviceId, venueId, exchangeSymbol).
       On startup a service sends one RegisterInstrument per active instrument.
       attrs.serviceId must refer to a registered service, otherwise the result
       is UnknownService.
       reportedTs: time when the service reported the instrument. It does not
       affect version: re-registering an instrument with unchanged attributes
       only refreshes the stored reportedTs. -->
  <sbe:message name="RegisterInstrument" id="12">
    <field name="clientId"   id="1" type="ClientId"/>
    <field name="requestId"  id="2" type="uint64"/>
    <field name="reportedTs" id="3" type="Timestamp"/>
    <field name="attrs"      id="4" type="InstrumentAttributes"/>
    <data  name="exchangeSymbol" id="5" type="varStringEncoding"/> <!-- natural key together with serviceId and venueId -->
    <data  name="symbol"         id="6" type="varStringEncoding"/> <!-- internal name, empty = generated by Metadata -->
  </sbe:message>

  <sbe:message name="RegisterInstrumentResult" id="13">
    <field name="clientId"     id="1" type="ClientId"/>
    <field name="requestId"    id="2" type="uint64"/>
    <field name="status"       id="3" type="RegisterStatus"/>
    <field name="instrumentId" id="4" type="InstrumentIdNULL" presence="optional"/> <!-- null if Rejected/UnknownService -->
    <field name="version"      id="5" type="uint32"/>
  </sbe:message>

  <!-- ================= Client -> Metadata ================= -->

  <!-- Filters are combined with AND; all null/empty = all services.
       Response: ServiceDefinition message(s) followed by RequestComplete. -->
  <sbe:message name="ServiceRequest" id="20">
    <field name="clientId"  id="1" type="ClientId"/>
    <field name="requestId" id="2" type="uint64"/>
    <field name="serviceId" id="3" type="ServiceIdNULL" presence="optional"/>
    <field name="state"     id="4" type="ServiceState"  presence="optional"/>
    <data  name="name"      id="5" type="varStringEncoding"/> <!-- empty = any -->
  </sbe:message>

  <!-- Filters are combined with AND; all null/empty = all instruments.
       A non-empty exchangeSymbol requires venueId.
       Response: InstrumentDefinition message(s) followed by RequestComplete. -->
  <sbe:message name="InstrumentRequest" id="21">
    <field name="clientId"       id="1" type="ClientId"/>
    <field name="requestId"      id="2" type="uint64"/>
    <field name="instrumentId"   id="3" type="InstrumentIdNULL" presence="optional"/>
    <field name="venueId"        id="4" type="UInt16NULL"       presence="optional"/>
    <field name="serviceId"      id="5" type="ServiceIdNULL"    presence="optional"/>
    <field name="instrumentType" id="6" type="InstrumentType"   presence="optional"/>
    <field name="state"          id="7" type="InstrumentState"  presence="optional"/>
    <data  name="exchangeSymbol" id="8" type="varStringEncoding"/> <!-- empty = any -->
  </sbe:message>

  <!-- ================= Metadata -> clients ================= -->

  <!-- Response to ServiceRequest, or a spontaneous update on the multicast
       queue (clientId = null, requestId = 0).
       A client applies the definition only if version is greater than the
       locally known version of this service. -->
  <sbe:message name="ServiceDefinition" id="30">
    <field name="clientId"   id="1" type="ClientIdNULL" presence="optional"/>
    <field name="requestId"  id="2" type="uint64"/>
    <field name="serviceId"  id="3" type="ServiceId"/>
    <field name="version"    id="4" type="uint32"/>
    <field name="reportedTs" id="5" type="Timestamp"/> <!-- last time the service reported itself -->
    <field name="state"      id="6" type="ServiceState"/>
    <data  name="name"         id="7" type="varStringEncoding"/>
    <data  name="dataQueue"    id="8" type="varStringEncoding"/>
    <data  name="requestQueue" id="9" type="varStringEncoding"/>
  </sbe:message>

  <!-- Response to InstrumentRequest, or a spontaneous update on the multicast
       queue (clientId = null, requestId = 0).
       A client applies the definition only if version is greater than the
       locally known version of this instrument.
       reportedTs: the last time a service reported the instrument. -->
  <sbe:message name="InstrumentDefinition" id="31">
    <field name="clientId"     id="1" type="ClientIdNULL" presence="optional"/>
    <field name="requestId"    id="2" type="uint64"/>
    <field name="instrumentId" id="3" type="InstrumentId"/>
    <field name="version"      id="4" type="uint32"/>
    <field name="reportedTs"   id="5" type="Timestamp"/>
    <field name="attrs"        id="6" type="InstrumentAttributes"/>
    <data  name="exchangeSymbol" id="7" type="varStringEncoding"/>
    <data  name="symbol"         id="8" type="varStringEncoding"/>
  </sbe:message>

  <!-- Terminates ServiceRequest and InstrumentRequest.
       count = number of definitions sent. -->
  <sbe:message name="RequestComplete" id="32">
    <field name="clientId"  id="1" type="ClientId"/>
    <field name="requestId" id="2" type="uint64"/>
    <field name="status"    id="3" type="RequestStatus"/>
    <field name="count"     id="4" type="uint32"/>
  </sbe:message>
</sbe:messageSchema>
