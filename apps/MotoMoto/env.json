{
    "scope": "dev",
    "working-directory": ".",
    "queues": [
        // everything MotoMoto publishes: responses and spontaneous definitions
        { "name": "${SCOPE}/metadata@data", "type": "multicast", "capacity": "64MiB" },
        // requests to MotoMoto: registrations and reference data queries
        { "name": "${SCOPE}/metadata@cmd", "type": "mpsc", "length": 1024, "slot-size": "512B" }
    ],
    "services": [
        // MotoMoto itself; clients learn its queues from this static configuration
        {
            "name": "MotoMoto",
            "service-id": 1,
            "queues": {
                "cmd": "${SCOPE}/metadata@cmd",
                "data": "${SCOPE}/metadata@data"
            }
        }
    ]
}
